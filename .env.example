# Copie para .env.local (que não vai para o GitHub) e preencha.
# Nenhuma destas variáveis leva NEXT_PUBLIC_: todas ficam só no servidor.

# Supabase do projeto autoria-audio (Settings > Data API e Settings > API Keys)
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Google AI Studio: chave do projeto do hackathon
GEMINI_TTS_API_KEY=
# Id exato do modelo de voz e do modelo que transcreve (conferência)
GEMINI_TTS_MODELO=
GEMINI_STT_MODELO=

# Anthropic (sugestão de pronúncia dos nomes): chave própria da demonstração, com limite de gasto
ANTHROPIC_API_KEY=
# Opcional: modelo da sugestão (padrão claude-sonnet-5-5)
AUDIO_PRONUNCIA_MODELO=
